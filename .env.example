# =============================================
# LiteLLM 設定（助教提供，用於 Chat Completion）
# =============================================
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=https://your-litellm-endpoint/

# =============================================
# Embedding Model 設定（使用 sentence-transformers 本地模型）
# =============================================
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Vector DB 設定（pgvector）
# =============================================
PGVECTOR_CONNECTION_STRING=postgresql://your_user:your_password@localhost:5432/your_db